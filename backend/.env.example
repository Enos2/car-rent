# File: backend/.env.example
# Purpose: Template of the settings the API needs. Copy it to .env and fill in real
#          values. Never put real passwords or keys in this example file.

NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Connection string from your database provider (Neon). Keep it secret.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
DATABASE_SSL=true

# Secret that signs login tokens: a long random value, at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-value-of-32-or-more-characters
JWT_EXPIRES_IN_SECONDS=3600

# Optional. Where uploaded ID documents are stored, and the largest allowed file.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# File: backend/.env.example
# END OF FILE
